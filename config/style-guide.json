  "rules": [
    {
      "id": "S-JA-001",
      "title": "句読点は「、」「。」に統一する",
      "enforcement": "error"
    },
    {
      "id": "S-JA-002",
      "title": "英数字は半角で書く",
      "enforcement": "error"
    },
    {
      "id": "S-JA-003",
      "title": "感嘆符・疑問符は半角で書く",
      "enforcement": "error"
    },
    {
      "id": "S-JA-004",
      "title": "括弧は半角 () に統一する",
      "enforcement": "error"
    },
    {
      "id": "S-JA-005",
      "title": "全角スペースを使わない",
      "enforcement": "error"
    },
    {
      "id": "S-JA-006",
      "title": "半角括弧の外側に半角スペースを1つ置く",
      "enforcement": "error"
    },
    {
      "id": "S-JA-007",
      "title": "本文の文体は常体に統一する",
      "enforcement": "error"
    },
    {
      "id": "S-SYM-001",
      "title": "全角ダッシュは ― (U+2015) を使う",
      "enforcement": "error"
    },
    {
      "id": "S-SYM-002",
      "title": "波ダッシュは 〜 (U+301C) を使う",
      "enforcement": "error"
    },
    {
      "id": "S-CODE-001",
      "title": "コードブロックには必ず言語を指定する",
      "enforcement": "error"
    },
    {
      "id": "S-CODE-002",
      "title": "コードブロックの言語識別子は許可一覧から選ぶ",
      "enforcement": "error"
    },
    {
      "id": "S-CODE-003",
      "title": "表はGFMのパイプ表とし区切り行を置く",
      "enforcement": "error"
    },
    {
      "id": "S-CODE-004",
      "title": "図はテキスト図としてコードブロックに置く",
      "enforcement": "error"
    },
    {
      "id": "S-CODE-005",
      "title": "注意・補足はブロック引用の見出し付きで書く",
      "enforcement": "error"
    },
    {
      "id": "S-TERM-001",
      "title": "用語集の非正規表記を使わない",
      "enforcement": "error"
    },
    {
      "id": "S-TERM-002",
      "title": "用語集の非推奨表記を新規に増やさない",
      "enforcement": "baseline"
    },
    {
      "id": "S-EN-001",
      "title": "略語は初出で英語正式名称を併記する",
      "enforcement": "baseline"
    },
    {
      "id": "S-VAGUE-001",
      "title": "曖昧表現は時点・出典・判定基準を添えて使う",
      "enforcement": "baseline"
    },
    {
      "id": "S-IDX-001",
      "title": "索引語に非正規表記を含めない",
      "enforcement": "error"
    },
    {
      "id": "S-IDX-002",
      "title": "索引必須の用語は索引に存在させる",
      "enforcement": "error"
    },
    {
      "id": "S-META-001",
      "title": "ルールIDはSTYLE_GUIDE.mdと一致させる",
      "enforcement": "error"
    }
  ],
