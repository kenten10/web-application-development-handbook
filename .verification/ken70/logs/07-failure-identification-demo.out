## 手順2: code/ch07/redux.solution.ts の末尾へ意図的な型エラーを1行加える
$ tail -4 code/ch07/redux.solution.ts

// KEN-70: 失敗時の識別を確認するための一時的な型エラー
const ken70Deliberate: number = "KEN-70";
void ken70Deliberate;

