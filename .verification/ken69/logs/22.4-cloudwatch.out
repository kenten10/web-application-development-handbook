== 22.4 SLO Burn Rate: CloudWatchアラーム+SNS通知先 ==
-- 通知先SNS topic作成 --
arn:aws:sns:ap-northeast-1:000000000000:handbook-slo-alerts
-- burn rateメトリクスのアラーム定義 (閾値14.4x / 5分) --
-- 発火条件超過のメトリクス投入 (burn rate 50) --
-- アラーム状態遷移 (ALARM) --
{
    "state": "ALARM",
    "threshold": 14.4,
    "metric": "BurnRate",
    "actions": [
        "arn:aws:sns:ap-northeast-1:000000000000:handbook-slo-alerts"
    ]
}
-- 非発火条件 (burn rate 0.5 → OK) --
OK
-- アラーム履歴 (発火→回復) --
[
    "Alarm updated from INSUFFICIENT_DATA to ALARM",
    "Alarm updated from ALARM to OK"
]
