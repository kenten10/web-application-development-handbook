date: 2026-08-30T13:16:37Z
source: タグ v1.0.0 のクリーンクローン ($SCRATCH/tag-clone-v1.0.0)

=== 生成コマンド ===
find site -type f | LC_ALL=C sort > filelist.txt          # 33ファイル
find site -print0 | xargs -0 touch -t 202608300000.00     # mtime を releaseDate へ正規化
COPYFILE_DISABLE=1 tar --format=ustar --uid 0 --gid 0 --numeric-owner \
  -cf handbook-v1.0.0-site.tar -T filelist.txt
gzip -9 -n handbook-v1.0.0-site.tar
COPYFILE_DISABLE=1 zip -q -X -9 handbook-v1.0.0-site.zip -@ < filelist.txt

